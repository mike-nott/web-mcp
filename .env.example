# Web-MCP configuration.
#
# Copy to .dev.vars for local development, or set each value as a Cloudflare
# secret for deployment:  echo "<value>" | npx wrangler secret put NAME
#
# MCP_AUTH_TOKEN is the ONLY required value. Every provider below is optional
# and independent — set the keys for the sources you want and delete the rest.
# The server only advertises tools whose providers are configured.

# ── Required ────────────────────────────────────────────────────────────────
# Generate with:
#   echo "webmcp_$(openssl rand 32 | base64 | tr '+/' '-_' | tr -d '=\n')"
MCP_AUTH_TOKEN=

# ── Free providers ──────────────────────────────────────────────────────────
# Reddit — https://reddit.com/prefs/apps, app type "script".
# Unlocks Reddit search/threads and find_communities.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API v3 — https://console.cloud.google.com
# Unlocks YouTube search and comments. (Transcripts need SUPADATA_API_KEY.)
YOUTUBE_API_KEY=

# Tavily — https://app.tavily.com — 1,000 credits/month free.
# Unlocks web_search keyword mode.
TAVILY_API_KEY=

# ── Paid providers ──────────────────────────────────────────────────────────
# TwitterAPI.io — https://twitterapi.io — ~$0.15/1k tweets. Unlocks X.
TWITTERAPI_IO_KEY=

# Supadata — https://supadata.ai — free tier 100/month. Video transcripts.
SUPADATA_API_KEY=

# FireCrawl — https://firecrawl.dev — 1-5 credits, only when a page is blocked.
FIRECRAWL_API_KEY=

# Brave Search — https://api-dashboard.search.brave.com — ~$5/1k, no free tier.
# Alternative or addition to Tavily for web_search keyword mode.
BRAVE_API_KEY=

# Exa — https://dashboard.exa.ai — ~$0.007/call. web_search semantic mode.
EXA_API_KEY=
